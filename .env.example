# OpenAI Agents SDK credential
OPENAI_API_KEY=

# Optional runner defaults
ANALYSIS_MODEL=gpt-5.6-sol

# IDA installation and license settings vary by platform.
# IDA_PATH=/opt/ida-pro-9.3
# IDA_LICENSE_FILE=/path/to/ida.hexlic
# IDA_LICENSE_HOST=
# IDA_LICENSE_PORT=
# IDA_LICENSE_ID=

# Optional external location for project artifacts. The CLI still requires an
# explicit --project-dir so that a run never silently lands in the source tree.
# VERIFIED_IDA_RUN_ROOT=/path/to/verified-ida-runs
