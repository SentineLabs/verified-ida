{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelone.com/schemas/verified-ida/v1/receipt.schema.json",
  "title": "Verified IDA Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "operation_id",
    "work_item_id",
    "kind",
    "artifact",
    "target",
    "status",
    "stage",
    "before",
    "desired",
    "observed",
    "execution",
    "normalization",
    "effects",
    "persistence",
    "semantic_review",
    "errors",
    "evidence",
    "recovery",
    "implementation",
    "timestamp"
  ],
  "properties": {
    "schema": {"const": "verified_ida.receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": ["string", "null"]},
    "kind": {"type": "string", "minLength": 1},
    "artifact": {"type": "object"},
    "target": {"type": "object"},
    "status": {"enum": ["rejected", "conflict", "blocked", "failed", "ineffective", "unverified", "verified", "verified_existing"]},
    "stage": {
      "enum": [
        "validation",
        "execution",
        "readback",
        "rerender",
        "persistence",
        "semantic_review",
        "transaction_verification",
        "transaction_semantic_delta"
      ]
    },
    "before": {},
    "desired": {},
    "observed": {},
    "execution": {"type": "object"},
    "normalization": {"type": "object"},
    "effects": {"type": "object"},
    "persistence": {"enum": ["not_checked", "pending", "verified", "failed"]},
    "semantic_review": {"enum": ["unreviewed", "accepted", "rejected", "superseded"]},
    "errors": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "recovery": {"type": ["string", "null"]},
    "implementation": {"type": "object"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
