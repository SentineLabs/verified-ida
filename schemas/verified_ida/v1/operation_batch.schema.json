{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelone.com/schemas/verified-ida/v1/operation_batch.schema.json",
  "title": "Verified IDA Operation Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operations"],
  "properties": {
    "schema": {"const": "verified_ida.operation_batch.v1"},
    "require_persistence": {"type": "boolean", "default": false},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "operation.schema.json"}
    }
  }
}
